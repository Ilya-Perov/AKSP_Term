{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",

    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,

    "jsx": "react-jsx",

    /* TypeScript + React */
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Для Webpack: TypeScript должен ЭМИТИРОВАТЬ JS */
    "noEmit": false,

    /* Остальное */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
